# Copia este archivo a .env y llena los valores. .env nunca se sube al repo.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/pidefacil?stringtype=unspecified
DB_USER=
DB_PASSWORD=

# Llaves: cadenas largas y aleatorias (JWT_SECRET en Base64)
JWT_SECRET=
BOT_SECRET=

# Orígenes permitidos del panel (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Servicio de WhatsApp y flujo de n8n
WHATSAPP_URL=http://localhost:4000
N8N_WEBHOOK_URL=

# Cobros con Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Secreto de los webhooks de Rappi. Vacio = integracion apagada.
RAPPI_WEBHOOK_SECRET=

# Llave maestra del asistente (32 bytes en base64): cifra las llaves de IA de
# los restaurantes. Genera una con: openssl rand -base64 32
ASISTENTE_LLAVE_MAESTRA=

FLYWAY_ENABLED=true
PLAN_POR_DEFECTO=
APP_BRAND_NAME=Pide Fácil
APP_BRAND_ORIGIN=
PUBLIC_WEB_URL=http://localhost:4200
